# ── Admin dashboard (photo uploader) ──
ADMIN_USERNAME=admin
# Only used until the admin sets their own password from the dashboard.
ADMIN_PASSWORD=change-me
# Long random string used to sign admin sessions and reset links.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me-too

# ── Cloudinary (photo storage + saved admin password) ──
# Free account at https://cloudinary.com, copy these from the dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Gmail (password reset emails) ──
# Free. On the school Gmail account: turn on 2-Step Verification, then
# Google Account > Security > App passwords > generate one for "Mail".
# Paste the 16-character code below (spaces are fine to remove).
GMAIL_USER=excellentkenya@gmail.com
GMAIL_APP_PASSWORD=
# Where password reset links are sent. Defaults to GMAIL_USER if left blank.
ADMIN_EMAIL=

# Used to build links inside emails. Set to your live domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Existing (donor portal) ──
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
